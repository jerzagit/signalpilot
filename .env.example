# Telegram user account from https://my.telegram.org
TG_API_ID=12345678
TG_API_HASH=abcdef1234567890abcdef1234567890
# Optional. Leave blank to use the saved Telethon session or prompt on first login.
TG_PHONE=

# Telegram bot from @BotFather — used ONLY to post to the SignalPilot channel.
BOT_TOKEN=123456789:AAFxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Admin chat(s) for silent ops notifications (comma-separated allowed).
ADMIN_CHATS=987654321

# Destination signal channel (@username, or numeric -100… id). Bot must be an admin.
FORWARD_CHAT_ID=@SignalPilot

# Message branding
CHANNEL_HEADER=SignalPilot
FOOTER=Not financial advice. Trade at your own risk.
ADMIN_LINE=Pm admin for auto-trade and link to see our dashboard.
# Show the upstream provider name on published cards (false by default).
SHOW_SOURCE=false

# Signal sources to watch.
# Format: source_id:chat:parser_profile:name
# Parser profiles: geom5 | default | flexible (more can be added in core/parsers/)
# Leave unset to listen to nothing (bot will still run and ping admins).
SIGNAL_SOURCES=geom:-1002083967629:geom5:Geom V5

# Runtime survival
RECONNECT_ATTEMPTS=5
RECONNECT_BACKOFF_SECS=15

# MT5 chart screenshot attached to follow-up cards (requires Pillow + the MT5
# terminal open on this PC). Title keywords used to find the MT5 window.
MT5_SCREENSHOT_ENABLED=true
MT5_WINDOW_TITLE=MetaTrader 5